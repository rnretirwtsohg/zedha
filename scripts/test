#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
source_dir=${1:-"$repo_root/.work/zed"}
test_command=${ZEDHA_TEST_COMMAND:-cargo test -p terminal_view terminal_launcher}

if [[ ! -d "$source_dir" ]]; then
  echo "source directory not found: $source_dir" >&2
  exit 1
fi

echo "Running Zedha validation in $source_dir"
# A login shell picks up toolchain setup (cargo, rustup) from the profile, but a
# profile may also change directory, so re-enter the source dir inside the shell.
ZEDHA_SOURCE_DIR="$source_dir" bash -lc 'cd "$ZEDHA_SOURCE_DIR" && eval "$1"' \
  zedha-test "$test_command"
