+pub async fn terminal_control_env_for_workspace(
+    workspace: &WeakEntity<Workspace>,
+    cx: &mut gpui::AsyncWindowContext,
+) -> HashMap<String, String> {
+    let Some(workspace_entity) = workspace.upgrade() else {
+        return HashMap::default();
+    };
+
+    let state = cx.update(|_, cx| {
+        let workspace = workspace_entity.read(cx);
+        (
+            workspace
+                .panel::<TerminalPanel>(cx)
+                .map(|panel| panel.read(cx).terminal_control_env()),
+            workspace.panels_initialized(),
+        )
+    });
+    match state {
+        Ok((Some(env), _)) => return env,
+        Ok((None, true)) | Err(_) => return HashMap::default(),
+        Ok((None, false)) => {}
+    }
+
+    let (tx, rx) = oneshot::channel();
+    let mut tx = Some(tx);
+    let subscription = cx.subscribe(&workspace_entity, move |workspace, event, cx| {
+        if !matches!(
+            event,
+            workspace::Event::PanelAdded(_) | workspace::Event::PanelsInitialized
+        ) {
+            return;
+        }
+        let env = workspace
+            .read(cx)
+            .panel::<TerminalPanel>(cx)
+            .map(|panel| panel.read(cx).terminal_control_env());
+        if env.is_none() && !matches!(event, workspace::Event::PanelsInitialized) {
+            return;
+        }
+        if let Some(tx) = tx.take() {
+            let _ = tx.send(env.unwrap_or_default());
+        }
+    });
+    let (released_tx, released_rx) = oneshot::channel();
+    let release_subscription = match cx.update(|_, cx| {
+        cx.observe_release(&workspace_entity, move |_, _| {
+            let _ = released_tx.send(());
+        })
+    }) {
+        Ok(subscription) => subscription,
+        Err(_) => return HashMap::default(),
+    };
+
+    // Panel initialization may have completed between the initial lookup and
+    // subscription registration.
+    match cx.update(|_, cx| {
+        let workspace = workspace_entity.read(cx);
+        (
+            workspace
+                .panel::<TerminalPanel>(cx)
+                .map(|panel| panel.read(cx).terminal_control_env()),
+            workspace.panels_initialized(),
+        )
+    }) {
+        Ok((Some(env), _)) => return env,
+        Ok((None, true)) | Err(_) => return HashMap::default(),
+        Ok((None, false)) => {}
+    }
+
+    // Do not pin the workspace while waiting. Workspace release cancels the
+    // wait and preserves the silent empty-environment fallback.
+    drop(workspace_entity);
+    let env = futures::select! {
+        env = futures::FutureExt::fuse(rx) => env.unwrap_or_default(),
+        _ = futures::FutureExt::fuse(released_rx) => HashMap::default(),
+    };
+    drop(subscription);
+    drop(release_subscription);
+    env
+}
