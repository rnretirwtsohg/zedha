+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct TerminalLaunchRequest {
+    pub id: u64,
+    pub workspace_token: String,
+    pub method: TerminalLaunchMethod,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum TerminalLaunchMethod {
+    Ensure(TerminalEnsureParams),
+    Close(TerminalCloseParams),
+}
+
+#[derive(Clone, Debug, Eq, PartialEq, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct TerminalEnsureParams {
+    pub session_key: String,
+    pub command: String,
+    #[serde(default)]
+    pub args: Vec<String>,
+    #[serde(default)]
+    pub cwd: Option<PathBuf>,
+    #[serde(default)]
+    pub env: HashMap<String, String>,
+    #[serde(default)]
+    pub label: Option<String>,
+    #[serde(default)]
+    pub close_on_exit: bool,
+    #[serde(default)]
+    pub focus: bool,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct TerminalCloseParams {
+    pub session_key: String,
+}
+
+#[derive(Debug, Deserialize)]
+struct RawLaunchRequest {
+    id: u64,
+    workspace: String,
+    method: String,
+    #[serde(default)]
+    params: serde_json::Value,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum TerminalLauncherResponse {
+    Ensured { terminal_id: u64, created: bool },
+    Closed { closed: bool },
+}
+
+#[derive(Clone, Debug, Serialize)]
+pub struct TerminalLauncherSuccess {
+    pub id: u64,
+    pub result: serde_json::Value,
+}
+
+pub fn parse_request(raw: &str) -> Result<TerminalLaunchRequest> {
+    if raw.len() > MAX_REQUEST_BYTES {
+        bail!("invalid terminal launcher request: exceeds size limit");
+    }
+
+    let raw: RawLaunchRequest =
+        serde_json::from_str(raw).context("invalid terminal launcher request")?;
+
+    let method = match raw.method.as_str() {
+        "terminal.ensure" => {
+            let params: TerminalEnsureParams =
+                serde_json::from_value(raw.params).context("invalid terminal launcher request")?;
+            if params.session_key.is_empty() {
+                bail!("invalid terminal launcher request: empty sessionKey");
+            }
+            TerminalLaunchMethod::Ensure(params)
+        }
+        "terminal.close" => {
+            let params: TerminalCloseParams =
+                serde_json::from_value(raw.params).context("invalid terminal launcher request")?;
+            if params.session_key.is_empty() {
+                bail!("invalid terminal launcher request: empty sessionKey");
+            }
+            TerminalLaunchMethod::Close(params)
+        }
+        _ => bail!("invalid terminal launcher request: unsupported method"),
+    };
+
+    Ok(TerminalLaunchRequest {
+        id: raw.id,
+        workspace_token: raw.workspace,
+        method,
+    })
+}
+
+pub(crate) fn launcher_task_id(session_key: &str) -> TaskId {
+    TaskId(format!("terminal-launcher:{session_key}"))
+}
+
+pub fn request_to_task(request: TerminalLaunchRequest) -> SpawnInTerminal {
+    let TerminalLaunchMethod::Ensure(ensure) = request.method else {
+        panic!("request_to_task only supports terminal.ensure");
+    };
+    let label = ensure
+        .label
+        .clone()
+        .filter(|label| !label.is_empty())
+        .unwrap_or_else(|| {
+            if ensure.args.is_empty() {
+                ensure.command.clone()
+            } else {
+                format!("{} {}", ensure.command, ensure.args.join(" "))
+            }
+        });
+    let command_label = if ensure.args.is_empty() {
+        ensure.command.clone()
+    } else {
+        format!("{} {}", ensure.command, ensure.args.join(" "))
+    };
+
+    SpawnInTerminal {
+        id: launcher_task_id(&ensure.session_key),
+        full_label: label.clone(),
+        label,
+        command: Some(ensure.command),
+        args: ensure.args,
+        command_label,
+        cwd: ensure.cwd,
+        env: ensure.env,
+        use_new_terminal: true,
+        allow_concurrent_runs: true,
+        reveal: if ensure.focus {
+            RevealStrategy::Always
+        } else {
+            RevealStrategy::NoFocus
+        },
+        reveal_target: RevealTarget::Dock,
+        hide: if ensure.close_on_exit {
+            HideStrategy::Always
+        } else {
+            HideStrategy::Never
+        },
+        ..Default::default()
+    }
+}
+
+pub fn success_response(id: u64, response: TerminalLauncherResponse) -> TerminalLauncherSuccess {
+    let result = match response {
+        TerminalLauncherResponse::Ensured {
+            terminal_id,
+            created,
+        } => {
+            serde_json::json!({ "terminalId": terminal_id, "created": created })
+        }
+        TerminalLauncherResponse::Closed { closed } => {
+            serde_json::json!({ "closed": closed })
+        }
+    };
+    TerminalLauncherSuccess { id, result }
+}
+
+fn error_response_line(message: &str) -> String {
+    let mut message = message.to_string();
+    if message.len() > MAX_ERROR_BYTES {
+        message.truncate(MAX_ERROR_BYTES);
+    }
+    format!("{}\n", serde_json::json!({ "error": message }))
+}
