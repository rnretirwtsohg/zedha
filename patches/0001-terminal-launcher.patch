+    pub fn spawn_terminal_launch_request(
+        &mut self,
+        request: TerminalLaunchRequest,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> Task<Result<WeakEntity<Terminal>>> {
+        let task = terminal_launcher::request_to_task(request);
+        self.spawn_task(&task, window, cx)
+    }
+
+    pub fn ensure_terminal_launch_request(
+        &mut self,
+        request: TerminalLaunchRequest,
+        window: &mut Window,
+        cx: &mut Context<Self>,
+    ) -> Task<Result<(WeakEntity<Terminal>, bool)>> {
+        let TerminalLaunchMethod::Ensure(ensure) = request.method.clone() else {
+            return Task::ready(Err(anyhow!(
+                "ensure_terminal_launch_request only supports terminal.ensure"
+            )));
+        };
+
+        let session_key = ensure.session_key.clone();
+        let focus = ensure.focus;
+
+        if let Some((item_index, pane, terminal_view)) =
+            self.find_launcher_terminal_view(&session_key, cx)
+        {
+            if focus {
+                self.activate_terminal_view(&pane, item_index, true, window, cx);
+                let workspace = self.workspace.clone();
+                cx.spawn_in(window, async move |_, cx| {
+                    workspace
+                        .update_in(cx, |workspace, window, cx| {
+                            workspace.focus_panel::<Self>(window, cx);
+                        })
+                        .ok();
+                })
+                .detach();
+            }
+            return Task::ready(Ok((terminal_view.read(cx).terminal().downgrade(), false)));
+        }
+
+        if self.pending_launcher_ensures.contains_key(&session_key) {
+            let (tx, rx) = oneshot::channel();
+            self.pending_launcher_ensures
+                .entry(session_key.clone())
+                .or_default()
+                .push(tx);
+            let workspace = self.workspace.clone();
+            return cx.spawn_in(window, async move |this, cx| {
+                let terminal = rx
+                    .await
+                    .map_err(|_| anyhow!("launcher ensure waiter dropped"))?
+                    .map_err(|error| anyhow!(error))?;
+                if focus {
+                    this.update_in(cx, |this, window, cx| {
+                        if let Some((item_index, pane, _)) =
+                            this.find_launcher_terminal_view(&session_key, cx)
+                        {
+                            this.activate_terminal_view(&pane, item_index, true, window, cx);
+                        }
+                    })
+                    .ok();
+                    workspace
+                        .update_in(cx, |workspace, window, cx| {
+                            workspace.focus_panel::<Self>(window, cx);
+                        })
+                        .ok();
+                }
+                Ok((terminal, false))
+            });
+        }
+
+        self.pending_launcher_ensures
+            .insert(session_key.clone(), Vec::new());
+
+        let spawn = self.spawn_terminal_launch_request(request, window, cx);
+        cx.spawn(async move |this, cx| {
+            let result = spawn.await;
+            let notify = this.update(cx, |this, _| {
+                this.pending_launcher_ensures
+                    .remove(&session_key)
+                    .unwrap_or_default()
+            })?;
+
+            match &result {
+                Ok(terminal) => {
+                    for waiter in notify {
+                        waiter.send(Ok(terminal.clone())).ok();
+                    }
+                    Ok((terminal.clone(), true))
+                }
+                Err(error) => {
+                    let message = error.to_string();
+                    for waiter in notify {
+                        waiter.send(Err(message.clone())).ok();
+                    }
+                    Err(anyhow!(message))
+                }
+            }
+        })
+    }
