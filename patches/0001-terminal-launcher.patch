+    async fn test_agent_terminal_waits_for_workspace_terminal_control_env(cx: &mut TestAppContext) {
+        let (panel, mut cx) = setup_panel(cx).await;
+        cx.executor().allow_parking();
+        cx.update(|_, cx| {
+            terminal_view::init(cx);
+            let mut settings = AgentSettings::get_global(cx).clone();
+            settings.terminal_init_command = Some(
+                "printf 'launcher_socket=<%s>\\nlauncher_workspace=<%s>\\n' \
+                 \"$ZED_TERMINAL_CONTROL_SOCKET\" \
+                 \"$ZED_TERMINAL_CONTROL_WORKSPACE\""
+                    .to_string(),
+            );
+            AgentSettings::override_global(settings, cx);
+
+            let mut terminal_settings = TerminalSettings::get_global(cx).clone();
+            terminal_settings.shell = task::Shell::Program("/bin/sh".to_string());
+            TerminalSettings::override_global(terminal_settings, cx);
+        });
+
+        let workspace = panel.read_with(&cx, |panel, _| panel.workspace.upgrade().unwrap());
+        workspace.update_in(&mut cx, |workspace, window, cx| {
+            if let Some(existing_panel) = workspace.panel::<TerminalPanel>(cx) {
+                workspace.remove_panel::<TerminalPanel>(&existing_panel, window, cx);
+            }
+            assert!(workspace.panel::<TerminalPanel>(cx).is_none());
+        });
+        let terminal_id = TerminalId::new();
+        panel.update_in(&mut cx, |panel, window, cx| {
+            panel.spawn_terminal(
+                terminal_id,
+                None,
+                None,
+                None,
+                None,
+                true,
+                true,
+                true,
+                AgentThreadSource::AgentPanel,
+                window,
+                cx,
+            );
+        });
+        cx.run_until_parked();
+
+        // Add the terminal panel after the agent terminal spawn starts. The
+        // spawn must wait rather than capture an empty launcher environment.
+        workspace.update_in(&mut cx, |workspace, window, cx| {
+            let terminal_panel = cx.new(|cx| TerminalPanel::new(workspace, window, cx));
+            workspace.add_panel(terminal_panel, window, cx);
+        });
+
+        let deadline = Instant::now() + Duration::from_secs(10);
+        loop {
+            cx.run_until_parked();
+            let content = panel.read_with(&cx, |panel, cx| {
+                panel
+                    .terminals
+                    .get(&terminal_id)
+                    .map(|terminal| terminal.view.read(cx).terminal().read(cx).get_content())
+                    .unwrap_or_default()
+            });
+            if content.matches("launcher_workspace=<").count() >= 2 {
+                assert!(!content.contains("launcher_socket=<>"), "{content}");
+                assert!(!content.contains("launcher_workspace=<>"), "{content}");
+                break;
+            }
+            assert!(Instant::now() < deadline, "terminal output: {content}");
+            cx.executor().advance_clock(Duration::from_millis(10));
+        }
+    }
