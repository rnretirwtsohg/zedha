+        let (first, second) = futures::join!(first_task, second_task);
+        let first = first.expect("first concurrent ensure should succeed");
+        let second = second.expect("second concurrent ensure should succeed");
+        cx.run_until_parked();
+
+        let TerminalLauncherResponse::Ensured {
+            terminal_id: first_id,
+            created: first_created,
+        } = first
+        else {
+            panic!("expected ensured response, got {first:?}");
+        };
+        let TerminalLauncherResponse::Ensured {
+            terminal_id: second_id,
+            created: second_created,
+        } = second
+        else {
+            panic!("expected ensured response, got {second:?}");
+        };
