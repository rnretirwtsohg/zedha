From 28e1fd91da5f1e281a34f8d2ebd218d7021d948b Mon Sep 17 00:00:00 2001
From: Naresh <ghostwriternr@gmail.com>
Date: Mon, 5 Oct 2026 10:10:31 +0100
Subject: [PATCH] Brand Linux distribution as Zedha

---
 crates/cli/src/main.rs              | 7 +++++--
 crates/zed/resources/zed.desktop.in | 4 ++--
 2 files changed, 7 insertions(+), 4 deletions(-)

diff --git a/crates/cli/src/main.rs b/crates/cli/src/main.rs
index 7676d52..cb3ec6d 100644
--- a/crates/cli/src/main.rs
+++ b/crates/cli/src/main.rs
@@ -908,8 +908,11 @@ mod linux {
 
                 // libexec is the standard, lib/zed is for Arch (and other non-libexec distros),
                 // ./zed is for the target directory in development builds.
-                let possible_locations =
-                    ["../libexec/zed-editor", "../lib/zed/zed-editor", "./zed"];
+                let possible_locations = [
+                    "../libexec/zedha-editor",
+                    "../lib/zedha/zedha-editor",
+                    "./zedha",
+                ];
                 possible_locations
                     .iter()
                     .find_map(|p| dir.join(p).canonicalize().ok().filter(|path| path != &cli))
diff --git a/crates/zed/resources/zed.desktop.in b/crates/zed/resources/zed.desktop.in
index eaace15..04efa57 100644
--- a/crates/zed/resources/zed.desktop.in
+++ b/crates/zed/resources/zed.desktop.in
@@ -9,11 +9,11 @@ StartupNotify=$DO_STARTUP_NOTIFY
 Exec=$APP_CLI $APP_ARGS
 Icon=$APP_ICON
 Categories=Utility;TextEditor;Development;IDE;
-Keywords=zed;
+Keywords=zedha;
 # To add Zed to "Open Folder With..." context menu, add `inode/directory` to the MimeType field (semicolon separated)
 # Arch linux users have reported this setting Zed as default file browser. See https://github.com/zed-industries/zed/pull/39076 and related issues.
 # If this happens to you, an unconfirmed fix may be to install Arch's `gnome-defaults-list` package.
-MimeType=text/plain;application/x-zerosize;x-scheme-handler/zed;
+MimeType=text/plain;application/x-zerosize;x-scheme-handler/zedha;
 Actions=NewWorkspace;
 
 [Desktop Action NewWorkspace]
-- 
2.55.0

